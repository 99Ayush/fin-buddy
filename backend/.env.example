# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored - never commit real keys.

PORT=4000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://user:password@host:27017/finbuddy?ssl=true&authSource=admin&retryWrites=true&w=majority

# JWT (required)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# LLM_PROVIDER picks the provider: grok | gemini | groq | openrouter.
# If the selected provider has no API key, the adapter falls back to the first
# provider that does, so the app never silently returns fabricated values.
LLM_PROVIDER=grok

# xAI Grok (primary). Keys start with "xai-" and are created at https://console.x.ai
GROK_API_KEY=
# Optional model override. Default: grok-4.7
GROK_MODEL=grok-4.7

# Google Gemini (fallback)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Groq - open-weight models on api.groq.com (different service from xAI Grok)
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Finnhub - free key from https://finnhub.io/register
FINNHUB_API_KEY=
